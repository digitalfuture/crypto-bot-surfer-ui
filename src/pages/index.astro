---
import Layout from "../layouts/Layout.astro";
import Chart from "../components/Chart.vue";
---

<Layout title="Chart">
  <div id="initial-dna-loader" class="initial-dna-loader" aria-label="Loading DNA TRADE">
    <div class="initial-dna-loader__logo">
      <div class="initial-dna-loader__dna">DNA</div>
      <div class="initial-dna-loader__trade">TRADE</div>
      <img src="/favicon.png" alt="DNATRADE" class="initial-dna-loader__icon" />
    </div>
  </div>
  <Chart client:only="vue" />
</Layout>

<style is:global>
  .initial-dna-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-weight: bolder;
    font-family: Arial, sans-serif;
    z-index: 2000;
    transition: opacity 0.16s ease-out;
  }

  .initial-dna-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .initial-dna-loader__logo {
    position: relative;
    transform: scale(1.3);
  }

  .initial-dna-loader__dna {
    color: lightgrey;
    font-size: 59px;
    line-height: 44px;
    padding-inline-start: 45.9px;
  }

  .initial-dna-loader__trade {
    font-size: 51px;
    line-height: 47px;
    color: darkgray;
    padding-inline-start: 0;
  }

  .initial-dna-loader__icon {
    position: absolute;
    top: 0;
    left: 1px;
    width: 42px;
    filter: grayscale(1);
  }
</style>
